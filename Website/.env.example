# ---------------------------------------------------------------------------
# TBRide :: environment example
# Copy to .env and adjust for your machine:  cp .env.example .env
# ---------------------------------------------------------------------------

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL 16+
DATABASE_URL=postgres://postgres:1@localhost:5432/tbride_db

# JWT (HS256) signing secret — use a unique random value of at least 32 characters
JWT_SECRET=
JWT_TTL_SECONDS=43200

# Connection pool
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000

# Socket.IO keepalive
SOCKET_PING_INTERVAL_MS=20000
SOCKET_PING_TIMEOUT_MS=20000

# Fare model (UZS)
RIDE_BASE_FARE=9000
RIDE_PER_KM=2500
RIDE_AVG_SPEED_KMH=28
RIDE_MAX_PICKUP_DISTANCE_KM=25

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Comma separated origins, "*" allows all (local development)
CORS_ORIGINS=*

# Shared secret the Telegram bot sends in the X-Telegram-Token header.
# The bot's .env must carry the exact same value in WEBSITE_INTERNAL_TOKEN.
TELEGRAM_INTERNAL_TOKEN=
